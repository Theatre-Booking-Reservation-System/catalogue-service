{
  "family": "catalogue-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::470176527501:role/LabRole",
  "taskRoleArn": "arn:aws:iam::470176527501:role/LabRole",
  "containerDefinitions": [
    {
      "name": "catalogue-service",
      "image": "470176527501.dkr.ecr.us-east-1.amazonaws.com/catalogue-service:latest",
      "essential": true,
      "portMappings": [ { "containerPort": 8082, "protocol": "tcp" } ],
      "environment": [
        { "name": "JWT_SECRET", "value": "DbPgxPEztADVNGoeXqh2WnPT1iPrTVcGJHc6qJOqG95" },
        { "name": "DB_URL", "value": "jdbc:postgresql://theatre-postgres.cigowvxwdqqp.us-east-1.rds.amazonaws.com:5432/catalogue_db" },
        { "name": "DB_USERNAME", "value": "theatre" },
        { "name": "DB_PASSWORD", "value": "Theatre#1234" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/catalogue-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
